    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build:single && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
